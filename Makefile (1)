/* procinfo.c — сведения о текущем процессе без system() и внешних утилит.
 * СРС 1, задание 1 (общая часть). Вариант 8. */
#define _GNU_SOURCE
#include <errno.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/resource.h>
#include <sys/types.h>
#include <unistd.h>

/* Найти в /proc/self/status строку с ключом key и скопировать её значение */
static int status_field(const char *key, char *out, size_t outsz)
{
    FILE *f = fopen("/proc/self/status", "r");
    if (!f) { perror("fopen /proc/self/status"); return -1; }
    char line[256];
    size_t klen = strlen(key);
    int found = -1;
    while (fgets(line, sizeof line, f)) {
        if (strncmp(line, key, klen) == 0 && line[klen] == ':') {
            char *v = line + klen + 1;
            while (*v == ' ' || *v == '\t') v++;
            v[strcspn(v, "\n")] = '\0';
            snprintf(out, outsz, "%s", v);
            found = 0;
            break;
        }
    }
    fclose(f);
    return found;
}

int main(void)
{
    pid_t pid  = getpid();
    pid_t ppid = getppid();
    uid_t uid  = getuid();
    uid_t euid = geteuid();
    gid_t gid  = getgid();
    pid_t pgrp = getpgrp();
    pid_t sid  = getsid(0);
    if (sid == -1) { perror("getsid"); return EXIT_FAILURE; }

    errno = 0;                       /* getpriority может законно вернуть -1 */
    int nice_val = getpriority(PRIO_PROCESS, 0);
    if (nice_val == -1 && errno != 0) { perror("getpriority"); return EXIT_FAILURE; }

    char name[64] = "?", state[64] = "?", vol[32] = "?", invol[32] = "?", thr[16] = "?";
    if (status_field("Name", name, sizeof name) ||
        status_field("State", state, sizeof state) ||
        status_field("Threads", thr, sizeof thr) ||
        status_field("voluntary_ctxt_switches", vol, sizeof vol) ||
        status_field("nonvoluntary_ctxt_switches", invol, sizeof invol)) {
        fprintf(stderr, "не удалось прочитать поля /proc/self/status\n");
        return EXIT_FAILURE;
    }

    printf("=== procinfo: сведения о текущем процессе ===\n");
    printf("Имя                        : %s\n", name);
    printf("PID                        : %d\n", (int)pid);
    printf("PPID                       : %d\n", (int)ppid);
    printf("UID / EUID / GID           : %u / %u / %u\n", (unsigned)uid, (unsigned)euid, (unsigned)gid);
    printf("Группа процессов (PGID)    : %d\n", (int)pgrp);
    printf("Сессия (SID)               : %d\n", (int)sid);
    printf("Значение nice              : %d\n", nice_val);
    printf("Состояние                  : %s\n", state);
    printf("Число потоков              : %s\n", thr);
    printf("Добровольные переключения  : %s\n", vol);
    printf("Принудительные переключения: %s\n", invol);
    return EXIT_SUCCESS;
}
