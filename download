#!/usr/bin/env python3
"""plot.py — график ускорения по CSV из ./msort bench (stdin или файл).
Использование: ./msort bench | tee bench.csv ; python3 plot.py bench.csv"""
import sys, matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt

src = open(sys.argv[1]) if len(sys.argv) > 1 else sys.stdin
rows = [l.strip().split(",") for l in src if l[:1].isdigit()]
p = [int(r[0]) for r in rows]; s = [float(r[2]) for r in rows]
plt.figure(figsize=(6, 4))
plt.plot(p, p, "--", color="gray", label="идеальное (линейное)")
plt.plot(p, s, "o-", color="#1f5fa8", linewidth=2, label="измеренное")
for x, y in zip(p, s): plt.annotate(f"{y:.2f}", (x, y), textcoords="offset points", xytext=(0, 8), ha="center")
plt.xticks(p); plt.xlabel("Число потоков"); plt.ylabel("Ускорение S = T1 / Tp")
plt.title("Параллельная сортировка слиянием, N = 10^7")
plt.grid(alpha=.3); plt.legend(); plt.tight_layout()
plt.savefig(sys.argv[2] if len(sys.argv) > 2 else "speedup.png", dpi=150)
print("график сохранён")
